<UserControl
    x:Class="QTrack.Views.ProjectsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:QTrack.Models"
    xmlns:viewModels="clr-namespace:QTrack.ViewModels"
    d:DataContext="{d:DesignInstance viewModels:ProjectsViewModel}"
    d:DesignHeight="300"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding FetchProjectsAsyncCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <ListBox
        HorizontalContentAlignment="Stretch"
        AlternationCount="2"
        ItemContainerStyle="{StaticResource ListBoxItemContainerStyle}"
        ItemsSource="{Binding Projects}"
        SelectedItem="{Binding SelectedProject}">
        <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type models:Project}">
                <ContentControl>
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseDoubleClick">
                            <b:InvokeCommandAction Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=ListBox}, Path=DataContext.RaiseOpenProjectEventCommand}" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>

                    <Border>
                        <DockPanel Margin="0,2">
                            <!-- 左側：お気に入りアイコン -->
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Margin="10,0"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Left"
                                Kind="Star"
                                Opacity="0.2" />

                            <!-- 右端：選択中かつロード中ならスピナーを表示 -->
                            <ProgressBar
                                Width="20"
                                Height="20"
                                Margin="0,0,10,0"
                                DockPanel.Dock="Right"
                                IsIndeterminate="True">
                                <ProgressBar.Style>
                                    <Style BasedOn="{StaticResource MaterialDesignCircularProgressBar}" TargetType="ProgressBar">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <!-- ViewModelのIsLoadingがTrue かつ この行がSelectedProjectのときのみ表示 -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=ListBox}, Path=DataContext.IsLoading}" Value="True" />
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=ListBoxItem}, Path=IsSelected}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>

                            <!-- 中央：プロジェクト名 -->
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource CommonFontSize}"
                                Text="{Binding Name}" />

                            <!-- 右端 更新日時 -->
                            <TextBlock
                                Margin="10,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                FontSize="15"
                                Text="{Binding UpdatedAt, StringFormat=yy / MM / dd HH:mm}" />
                        </DockPanel>
                    </Border>
                </ContentControl>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>