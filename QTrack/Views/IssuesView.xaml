<UserControl
    x:Class="QTrack.Views.IssuesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:QTrack.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:QTrack.Models"
    xmlns:viewModels="clr-namespace:QTrack.ViewModels"
    d:DataContext="{d:DesignInstance viewModels:IssuesViewModel}"
    d:DesignHeight="300"
    d:DesignWidth="600"
    mc:Ignorable="d">
    <Grid Background="{StaticResource LightBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox
            AlternationCount="2"
            ItemContainerStyle="{StaticResource ListBoxItemContainerStyle}"
            ItemsSource="{Binding Issues}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:Issue}">
                    <StackPanel Margin="5,1" Orientation="Horizontal">
                        <controls:CustomCheckBox IsChecked="{Binding IsCompleted}" />

                        <Border Width="0" Margin="4,0" />

                        <controls:StateToggleButton Width="90" State="{Binding State}" />

                        <Border Width="0" Margin="8,0" />

                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="15"
                            Foreground="WhiteSmoke"
                            Text="{Binding Summary}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>


        <Border
            Grid.Row="1"
            Margin="5"
            Background="{StaticResource MediumBackgroundBrush}"
            CornerRadius="10,10,0,0">

            <!-- 入力エリア（Cardで囲む） -->
            <materialDesign:Card
                Margin="8"
                Padding="8"
                Background="Transparent"
                UniformCornerRadius="8">
                <StackPanel>
                    <!-- 1行目: 常に表示する最低限のUI -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            materialDesign:HintAssist.Hint="新しい課題のタイトルを入力... (Ctrl + Shift + Enter で追加)"
                            FontSize="14"
                            Foreground="WhiteSmoke"
                            Text="{Binding PendingIssue.Summary, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding
                                    Key="Return"
                                    Command="{Binding QuickAddAsyncCommand}"
                                    Modifiers="Ctrl+Shift" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- 詳細展開用トグルボタン -->
                        <ToggleButton
                            x:Name="ExpandDetailToggle"
                            Grid.Column="1"
                            Margin="8,0"
                            Style="{StaticResource MaterialDesignActionToggleButton}"
                            ToolTip="詳細フィールドを展開">
                            <ToggleButton.Content>
                                <materialDesign:PackIcon Kind="ChevronDown" />
                            </ToggleButton.Content>
                            <materialDesign:ToggleButtonAssist.OnContent>
                                <materialDesign:PackIcon Kind="ChevronUp" />
                            </materialDesign:ToggleButtonAssist.OnContent>
                        </ToggleButton>

                        <!-- 登録ボタン -->
                        <Button
                            Grid.Column="2"
                            Command="{Binding AddIssueAsyncCommand}"
                            Content="追加"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                    </Grid>

                    <!-- 2行目以降: トグルON時のみ表示されるUI -->
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsChecked, ElementName=ExpandDetailToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Separator Margin="0,0,0,8" Background="{StaticResource LightBackgroundBrush}" />

                        <!-- 説明文 -->
                        <TextBox
                            MaxHeight="100"
                            Margin="0,4"
                            materialDesign:HintAssist.Hint="詳細な説明やメモ..."
                            AcceptsReturn="True"
                            Text="{Binding PendingIssue.Description}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />

                        <!-- プロパティ群（ステータス、優先度、担当者、期日など） -->
                        <WrapPanel Margin="0,8,0,0">
                            <ComboBox
                                Width="120"
                                Margin="0,0,8,0"
                                materialDesign:HintAssist.Hint="タイプ" />

                            <materialDesign:NumericUpDown
                                Width="120"
                                Margin="0,0,8,0"
                                materialDesign:HintAssist.Hint="Rate"
                                Value="{Binding PendingIssue.Rate}" />

                            <materialDesign:NumericUpDown
                                Width="120"
                                Margin="0,0,8,0"
                                materialDesign:HintAssist.Hint="Entry No"
                                Value="{Binding PendingIssue.EntryNo}" />

                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

        </Border>


    </Grid>
</UserControl>