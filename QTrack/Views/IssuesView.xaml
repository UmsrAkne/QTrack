<UserControl
    x:Class="QTrack.Views.IssuesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:QTrack.Models"
    xmlns:viewModels="clr-namespace:QTrack.ViewModels"
    d:DataContext="{d:DesignInstance viewModels:IssuesViewModel}"
    d:DesignHeight="300"
    d:DesignWidth="600"
    mc:Ignorable="d">
    <Grid>
        <ListBox ItemContainerStyle="{StaticResource ListBoxItemContainerStyle}" ItemsSource="{Binding Issues}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:Issue}">
                    <StackPanel Margin="5,1" Orientation="Horizontal">
                        <CheckBox />

                        <Border Width="0" Margin="4,0" />

                        <Button Width="80" Content="Status" />

                        <Border Width="0" Margin="8,0" />

                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="15"
                            Foreground="WhiteSmoke"
                            Text="{Binding Summary}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>